# =========================================================================
# ZYNTRA '26 — ENVIRONMENT CONFIGURATION
# =========================================================================

# Server Port
PORT=5000

# Admin Access Passcode
ADMIN_KEY=your_secure_admin_passkey_here

# =========================================================================
# CLOUD DATABASE CONFIGURATION (Working both locally & when hosted!)
# =========================================================================

# OPTION 1: Neon Serverless PostgreSQL (Recommended - 100% Free, Instant 30s Setup)
# Sign up at https://neon.tech -> New Project -> Copy Connection String:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require

# OPTION 2: Supabase (Free PostgreSQL + Direct Frontend Client)
# Sign up at https://supabase.com -> New Project:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# OPTION 3: Vercel Postgres / Storage
# When deployed to Vercel, navigate to Project -> Storage -> Create Postgres.
# Vercel automatically populates POSTGRES_URL & DATABASE_URL!

# Set to false only for non-SSL localhost database
DATABASE_SSL=true
